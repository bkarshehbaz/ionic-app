{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../dist/out-tsc-e2e",      
    "sourceMap": true,
    "lib": [
      "dom",
      "es2016",
      "es2017"
    ],
    "target": "es6",
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
      "../src/lib/**/*.ts"
  ]
}
