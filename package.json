{
  "name": "vvs",
  "author": "Lucas Estrella",
  "description": "",
  "version": "0.0.6",
  "homepage": "",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "node-sass": "^8.0.0"
  },
  "betterScripts": {
    "build:ios": {
      "command": "node ./config/set-env.js ios && ionic cordova build ios --build-optimizer --vendor-chunk --aot",
      "env": {
        "NODE_ENV": "production",
        "isNative": "true",
        "IONIC_ENV": "prod",
        "CURR_ENV": "prod",
        "ENABLE_PROD_LOGGER": "true",
        "IONIC_AOT_WRITE_TO_DISK": "true",
        "MINIFY_STORAGE_KEYS": "true",
        "ENABLE_DEBUG_MODE": "false",
        "IONIC_GENERATE_SOURCE_MAP": "false",
        "env": "prod"
      }
    },
    "build:ios:dev": {
      "command": "node ./config/set-env.js ios && ionic cordova build ios",
      "env": {
        "NODE_ENV": "development",
        "isNative": "true",
        "IONIC_ENV": "dev",
        "CURR_ENV": "dev",
        "ENABLE_PROD_LOGGER": "false",
        "IONIC_AOT_WRITE_TO_DISK": "true",
        "MINIFY_STORAGE_KEYS": "false",
        "ENABLE_DEBUG_MODE": "false",
        "IONIC_GENERATE_SOURCE_MAP": "true",
        "env": "dev"
      }
    },
    "build:android": {
      "command": "node ./config/set-env.js android && ionic cordova build android --warning-mode=all --stacktrace --build-optimizer --vendor-chunk --aot",
      "env": {
        "NODE_ENV": "production",
        "isNative": "true",
        "IONIC_ENV": "prod",
        "CURR_ENV": "prod",
        "ENABLE_PROD_LOGGER": "true",
        "IONIC_AOT_WRITE_TO_DISK": "true",
        "MINIFY_STORAGE_KEYS": "true",
        "ENABLE_DEBUG_MODE": "false",
        "IONIC_GENERATE_SOURCE_MAP": "false",
        "env": "prod"
      }
    },
    "run:ios:dev": {
      "command": "ionic cordova build ios",
      "env": {
        "CURR_ENV": "prod",
        "ENABLE_PROD_LOGGER": "false",
        "MINIFY_STORAGE_KEYS": "false",
        "ENABLE_DEBUG_MODE": "true",
        "env": "dev"
      }
    },
    "build:android:dev": {
      "command": "ionic cordova build android",
      "env": {
        "isNative": "true",
        "IONIC_ENV": "prod",
        "CURR_ENV": "prod",
        "ENABLE_PROD_LOGGER": "false",
        "MINIFY_STORAGE_KEYS": "true",
        "ENABLE_DEBUG_MODE": "false",
        "IONIC_SOURCE_MAP_TYPE": "eval-source-map",
        "IONIC_GENERATE_SOURCE_MAP": "true",
        "env": "dev"
      }
    },
    "pro:build": {
      "command": "node ./config/set-env.js && node ./config/estrel_ready.config.js && ionic-app-scripts build --verbose --prod --aot --release --generateSourceMap false ",
      "env": {
        "isNative": "true",
        "IONIC_ENV": "prod",
        "CURR_ENV": "production",
        "ENABLE_PROD_LOGGER": "true",
        "MINIFY_STORAGE_KEYS": "true",
        "ENABLE_DEBUG_MODE": "false"
      }
    },
    "ionic:serve": {
      "command": "ionic-app-scripts serve --webpack ./config/webpack.config.js --port=8100",
      "env": {
        "isNative": "true",
        "CURR_ENV": "dev",
        "IONIC_SOURCE_MAP_TYPE": "eval-source-map",
        "IONIC_GENERATE_SOURCE_MAP": "true",
        "ENABLE_PROD_LOGGER": "false",
        "MINIFY_STORAGE_KEYS": "false",
        "ENABLE_DEBUG_MODE": "false",
        "env": "dev"
      }
    },
    "ionic:serve:debug": {
      "command": "node ./config/set-env.js && ionic-app-scripts serve --webpack ./config/webpack.dev.config.js",
      "env": {
        "CURR_ENV": "development",
        "IONIC_SOURCE_MAP_TYPE": "eval-source-map",
        "IONIC_GENERATE_SOURCE_MAP": "true",
        "ENABLE_PROD_LOGGER": "false",
        "MINIFY_STORAGE_KEYS": "false",
        "ENABLE_DEBUG_MODE": "true",
        "env": "dev"
      }
    },
    "ionic:serve:debug:prod": {
      "command": "node ./config/set-env.js && ionic-app-scripts serve --webpack ./config/webpack.dev.config.js",
      "env": {
        "CURR_ENV": "production",
        "IONIC_SOURCE_MAP_TYPE": "eval-source-map",
        "IONIC_GENERATE_SOURCE_MAP": "true",
        "ENABLE_PROD_LOGGER": "false",
        "MINIFY_STORAGE_KEYS": "false",
        "ENABLE_DEBUG_MODE": "true",
        "env": "prod"
      }
    }
  },
  "scripts": {
    "start": "better-npm-run ionic:serve:debug --port 4400",
    "start:local": "npm run start --env=local",
    "start:local:prod": "better-npm-run ionic:serve:debug:prod --port 4400",
    "start:dev": "npm run start --env=dev",
    "start:prod": "npm run start --env=prod",
    "docker:build": "docker build -t project001 .",
    "docker:run": "docker run -it --rm -p 4400:4400 -v ${PWD}:/usr/src/app project001 /bin/bash",
    "appium": "appium --chromedriver-executable e2e/chromedriver",
    "e2e:appium": "tsc --p ./e2e/pro.tsconfig.json && protractor ./e2e/protractor.appium.config.js --verbose",
    "e2e": "tsc --p ./e2e/pro.tsconfig.json && protractor ./e2e/protractor.browser.config.js --verbose",
    "ionic:build:after": "cat src/environments/index.ts",
    "build:ios": "node -e 'require(\"./config/clean-www-platform\")()' && node -e 'require(\"./config/clean-www-ios-platform\")()' && better-npm-run build:ios",
    "build:android": "node -e 'require(\"./config/clean-www-platform\")()' && node -e 'require(\"./config/clean-www-android-platform\")()' && better-npm-run build:android",
    "build:android:dev": "node -e 'require(\"./config/clean-www-platform\")()' && node -e 'require(\"./config/clean-www-android-platform\")()' && better-npm-run build:android:dev",
    "build:ios:dev": "node -e 'require(\"./config/clean-www-platform\")()' && node -e 'require(\"./config/clean-www-ios-platform\")()' && better-npm-run build:ios:dev",
    "emulate:android:dev": "better-npm-run emulate:android:dev",
    "run:ios:dev": "better-npm-run run:ios:dev",
    "ionic:serve": "better-npm-run ionic:serve",
    "build": "node -e 'require(\"./config/clean-www-platform\")()' && node -e 'require(\"./config/clean-www-ios-platform\")()' && better-npm-run pro:build",
    "ionic:deploy": "sudo git push ionic master",
    "job": "sudo ts-node --compilerOptions '{\"module\":\"commonjs\"}' tasks/index.ts",
    "task": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' tasks/index.ts",
    "clean": "ionic-app-scripts clean",
    "vvs-bridge": "npm i vvs-bridge@git+ssh://git-codecommit.us-west-2.amazonaws.com/v1/repos/vvs-bridge && npm i --prefix ./node_modules/vvs-bridge",
    "add-submodules": "git submodule add --recursive --remote && npm install --prefix src/lib/vvs-bridge",
    "add-submodule": "git submodule add -f https://gitlab.com/soliteksolutions/vvs-bridge src/lib/vvs-bridge",
    "update-submodules": "git submodule update --recursive --remote && npm install --prefix ./src/lib/vvs-bridge",
    "serveProd": "ionic serve --prod --webpack ./config/webpack.config.js --generateSourceMap true",
    "iosProd": "ionic cordova build ios --prod --aot --release --generateSourceMap false",
    "ios": "sudo ionic cordova run ios -lc",
    "fix-ios-perm": "sudo chmod -R 777 ./platforms/ios/",
    "open-x-code": "sudo open -a Xcode",
    "emulate": "ionic cordova emulate android",
    "ionic:build": "ionic-app-scripts build --prod --aot --release --generateSourceMap false",
    "lint": "ionic-app-scripts lint",
    "tslint": "tslint ./src/**/*.ts --config tslint.json",
    "fix-lint": "tslint --fix -t ./src/**/*.ts",
    "minify": "ionic-app-scripts minify",
    "test": "ng test -sm=false",
    "test:ci": "ng test --single-run --code-coverage",
    "_test": "karma start ./test-config/karma.conf.js",
    "test-ls": "karma start ./test-config/karma.conf.js",
    "postinstall": "webdriver-manager update",
    "compodoc": "node ./node_modules/.bin/compodoc -p ./tsconfig.json -s --theme material",
    "serve": "docsify serve docs"
  },
  "config": {
    "ionic_webpack": "./config/webpack.config.js",
    "ionic_copy": "./config/copy.config.js",
    "ionic_experimental_purge_decorators": "true",
    "ionic_aot_write_to_disk": "true"
  },
  "_config": {
    "ionic_copy": "./config/copy.config.js",
    "ionic_source_map_type": "source-map",
    "ionic_webpack": "./config/webpack.config.js",
    "ionic_experimental_purge_decorators": "true",
    "ionic_generate_source_map": "true"
  },
